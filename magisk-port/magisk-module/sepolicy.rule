# SELinux rules for the Dolby codec path, injected by magiskpolicy at boot.
#
# What magiskpolicy CAN do here: create new types and add allow rules into the
# live policy. What it CANNOT do: edit hwservice_contexts (that is a plain file
# read by hwservicemanager very early in boot). So the DMS IDms interface label
# still has to come from a hwservice_contexts entry that is in place before
# hwservicemanager starts — see README (direct install mode writes it into
# /vendor/etc/selinux/vendor_hwservice_contexts).
#
# The Dolby c2 service runs in the existing `mediacodec` domain (its exec file is
# labelled mediacodec_exec in file_contexts), so it needs no new domain — only
# permission to reach the DMS HAL.

# --- DMS HAL types ---
type hal_dms_default domain
type hal_dms_default_exec exec_type vendor_file_type file_type
type hal_dms_hwservice hwservice_manager_type

# Pragmatic: run the DMS daemon permissive so a missing niche allow does not
# silently break decoder config. Tighten once you have a clean audit log.
permissive hal_dms_default

# Let init launch the DMS daemon and transition it into its domain.
allow init hal_dms_default_exec file { read open getattr execute map }
allow init hal_dms_default process { transition }
allow hal_dms_default hal_dms_default_exec file { entrypoint read open getattr execute map }

# DMS registers and finds its own hwservice.
allow hal_dms_default hwservice_manager_type hwservice_manager { add find }
allow hal_dms_default hwservice_manager service_manager { add find }

# The decoders live in the mediacodec domain and must reach DMS.
allow mediacodec hal_dms_hwservice hwservice_manager find
allow mediacodec hal_dms_default binder call
allow hal_dms_default mediacodec binder call

# DMS parameter storage under /data/vendor/dolby.
allow hal_dms_default vendor_data_file dir { search open read write add_name remove_name rw_dir_perms }
allow hal_dms_default vendor_data_file file { create open read write unlink getattr setattr map }

# DMS reads vendor audio props.
allow hal_dms_default vendor_default_prop file { read open getattr map }
allow hal_dms_default property_socket sock_file write
unix_socket_connect(hal_dms_default, property, init)

# hwservicemanager must be allowed to hand out the new hwservice label.
allow hwservicemanager hal_dms_hwservice hwservice_manager_type
